# ===== إعدادات السيرفر (LAN) =====
# عند النشر على سيرفر الشركة، استبدل 127.0.0.1 بـ IP السيرفر
# مثال: VITE_SUPABASE_URL="http://192.168.1.100:54321"
# أو استخدم اسم نطاق داخلي: VITE_SUPABASE_URL="http://madar-server.local:54321"

# ===== بيانات الأدمن الافتراضي (seed) =====
